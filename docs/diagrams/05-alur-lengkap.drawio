          <mxGeometry x="420" y="10" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Admin: Approve/Reject -->
        <mxCell id="20" value="Approve or&#10;Reject" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;" parent="4" vertex="1">
