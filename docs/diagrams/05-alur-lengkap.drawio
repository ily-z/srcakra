<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="draw.io" type="device">
  <diagram name="05 - Alur Lengkap Pengunjung (End-to-End)">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Visitor Lane -->
        <mxCell id="2" value="Visitor" style="swimlane;swimlaneFillColor=#E3F2FD;startSize=40;horizontal=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="1000" height="260" as="geometry" />
        </mxCell>

        <!-- System Lane -->
        <mxCell id="3" value="System" style="swimlane;swimlaneFillColor=#F3E5F5;startSize=40;horizontal=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="300" width="1000" height="260" as="geometry" />
        </mxCell>

        <!-- Admin Lane -->
        <mxCell id="4" value="Admin" style="swimlane;swimlaneFillColor=#FFF3E0;startSize=40;horizontal=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="560" width="1000" height="260" as="geometry" />
        </mxCell>

        <!-- ============ PHASE 1: Pendaftaran ============ -->
        <!-- Phase label -->
        <mxCell id="p1" value="Phase 1: Pendaftaran" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#1565C0;" parent="1" vertex="1">
          <mxGeometry x="40" y="10" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Visitor: Start -->
        <mxCell id="10" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" parent="2" vertex="1">
          <mxGeometry x="40" y="60" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Visitor: Buka form booking -->
        <mxCell id="11" value="Buka website&#10;&amp; form booking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;" parent="2" vertex="1">
          <mxGeometry x="80" y="50" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Visitor: Isi data & submit -->
        <mxCell id="12" value="Isi data &amp;&#10;submit pendaftaran" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;" parent="2" vertex="1">
          <mxGeometry x="240" y="50" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- System: Validasi & simpan -->
        <mxCell id="13" value="Validasi &amp;&#10;simpan pendaftaran" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
