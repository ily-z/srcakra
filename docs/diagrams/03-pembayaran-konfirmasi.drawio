<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="draw.io" type="device">
  <diagram name="03 - Pembayaran &amp; Konfirmasi">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Admin Lane -->
        <mxCell id="2" value="Admin" style="swimlane;swimlaneFillColor=#FFF3E0;startSize=40;horizontal=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="800" height="260" as="geometry" />
        </mxCell>

        <!-- System Lane -->
        <mxCell id="3" value="System" style="swimlane;swimlaneFillColor=#F3E5F5;startSize=40;horizontal=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="300" width="800" height="400" as="geometry" />
        </mxCell>

        <!-- Visitor Lane (optional) -->
        <mxCell id="4" value="Visitor" style="swimlane;swimlaneFillColor=#E3F2FD;startSize=40;horizontal=1;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="700" width="800" height="80" as="geometry" />
        </mxCell>

        <!-- Start Node -->
        <mxCell id="10" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" parent="2" vertex="1">
          <mxGeometry x="370" y="10" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Action: Admin klik Mark as Paid -->
        <mxCell id="11" value="Admin klik&#10;&quot;Mark as Paid&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;" parent="2" vertex="1">
          <mxGeometry x="320" y="50" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Decision: Payment sudah paid? -->
        <mxCell id="12" value="Payment&#10;sudah paid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;" parent="2" vertex="1">
          <mxGeometry x="310" y="130" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- Action: Error sudah paid -->
        <mxCell id="13" value="Tampilkan error:&#10;&quot;Payment sudah&#10;diproses&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;" parent="2" vertex="1">
          <mxGeometry x="530" y="140" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- Action: Konfirmasi pembayaran -->
        <mxCell id="14" value="Konfirmasi&#10;pembayaran" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;" parent="2" vertex="1">
          <mxGeometry x="320" y="250" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- System: Validasi payment -->
        <mxCell id="20" value="Validasi data&#10;pembayaran" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
          <mxGeometry x="320" y="30" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Decision: Auto-approve? -->
        <mxCell id="21" value="Auto-approve&#10;pendaftar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
          <mxGeometry x="310" y="110" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- Action: Approve pendaftaran -->
        <mxCell id="22" value="Approve&#10;pendaftaran&#10;otomatis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
          <mxGeometry x="120" y="130" width="110" height="50" as="geometry" />
        </mxCell>

        <!-- Merge point 1 -->
        <mxCell id="23" value="" style="ellipse;fillColor=#FFFFFF;strokeColor=#7B1FA2;html=1;" parent="3" vertex="1">
          <mxGeometry x="375" y="225" width="10" height="10" as="geometry" />
        </mxCell>

        <!-- Decision: Sudah ada kunjungan? -->
        <mxCell id="24" value="Sudah ada&#10;kunjungan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
          <mxGeometry x="310" y="270" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- Action: Error duplikat -->
        <mxCell id="25" value="Tampilkan error:&#10;&quot;Kunjungan sudah&#10;ada&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;" parent="3" vertex="1">
          <mxGeometry x="530" y="280" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- Action: Buat kunjungan -->
        <mxCell id="26" value="Buat data&#10;kunjungan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
          <mxGeometry x="320" y="390" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Action: Kirim invoice -->
        <mxCell id="27" value="Generate &amp; kirim&#10;invoice / e-tiket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
          <mxGeometry x="320" y="470" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- End Node -->
        <mxCell id="28" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" parent="3" vertex="1">
          <mxGeometry x="370" y="520" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Visitor: Terima invoice -->
        <mxCell id="30" value="Terima invoice&#10;/ e-tiket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;" parent="4" vertex="1">
          <mxGeometry x="320" y="20" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Edges Admin lane -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="2" source="10" target="11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="2" source="11" target="12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;label=Ya;" parent="2" source="12" target="13" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;label=Tidak;" parent="2" source="12" target="14" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="14" target="20" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges System lane -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="3" source="20" target="21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;label=Ya;" parent="3" source="21" target="22" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;label=Tidak;" parent="3" source="21" target="23" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="3" source="22" target="23" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="3" source="23" target="24" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;label=Ya;" parent="3" source="24" target="25" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;label=Tidak;" parent="3" source="24" target="26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="3" source="26" target="27" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="3" source="27" target="28" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross-lane to Visitor -->
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="27" target="30" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
