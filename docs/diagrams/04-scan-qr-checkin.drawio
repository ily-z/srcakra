<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="draw.io" type="device">
  <diagram name="04 - Scan QR Check-in">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Admin Lane -->
        <mxCell id="2" value="Admin" style="swimlane;swimlaneFillColor=#FFF3E0;startSize=40;horizontal=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="800" height="230" as="geometry" />
        </mxCell>

        <!-- System Lane -->
        <mxCell id="3" value="System" style="swimlane;swimlaneFillColor=#F3E5F5;startSize=40;horizontal=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="270" width="800" height="480" as="geometry" />
        </mxCell>

        <!-- Start Node -->
        <mxCell id="10" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" parent="2" vertex="1">
          <mxGeometry x="370" y="10" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Action: Buka scanner page -->
        <mxCell id="11" value="Admin buka&#10;scanner page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;" parent="2" vertex="1">
          <mxGeometry x="320" y="50" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Action: Scan QR code -->
        <mxCell id="12" value="Scan QR Code&#10;pengunjung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;" parent="2" vertex="1">
          <mxGeometry x="320" y="130" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- System: Validasi token -->
        <mxCell id="20" value="Validasi&#10;token QR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
          <mxGeometry x="320" y="30" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Decision: Token valid? -->
        <mxCell id="21" value="Token&#10;valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
          <mxGeometry x="320" y="110" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Action: Token tidak valid -->
        <mxCell id="22" value="Tampilkan error:&#10;&quot;Token tidak&#10;valid&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;" parent="3" vertex="1">
          <mxGeometry x="530" y="120" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- Decision: Sudah completed? -->
        <mxCell id="23" value="Sudah completed&#10;sebelumnya?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
          <mxGeometry x="320" y="230" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Action: Sudah check-in -->
        <mxCell id="24" value="Tampilkan:&#10;&quot;Sudah check-in&#10;sebelumnya&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;" parent="3" vertex="1">
          <mxGeometry x="530" y="240" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- Action: Update kunjungan -->
        <mxCell id="25" value="Update status&#10;kunjungan =&#10;Completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;" parent="3" vertex="1">
          <mxGeometry x="320" y="350" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- End Node -->
        <mxCell id="26" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" parent="3" vertex="1">
          <mxGeometry x="370" y="420" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Edges Admin lane -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="2" source="10" target="11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="2" source="11" target="12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross-lane -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="12" target="20" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges System lane -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="3" source="20" target="21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;label=Tidak;" parent="3" source="21" target="22" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;label=Ya;" parent="3" source="21" target="23" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;label=Ya;" parent="3" source="23" target="24" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;label=Tidak;" parent="3" source="23" target="25" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="3" source="25" target="26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
